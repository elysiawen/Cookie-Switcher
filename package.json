{
  "name": "cookie-profile-switcher",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "保存并一键切换网站 Cookie 身份（附 localStorage）",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build": "npm run icons && tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "pack": "npm run build && node scripts/pack.mjs",
    "pack:zip": "npm run build && node scripts/pack.mjs --zip",
    "pack:crx": "npm run build && node scripts/pack.mjs --crx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
